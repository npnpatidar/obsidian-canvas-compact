{
  "name": "canvas-compact",
  "version": "2.0.6",
  "description": "Obsidian plugin: resize canvas cards to fit content and pack layout to minimum area — edge-aware",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "./scripts/run-checks.sh",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "canvas",
    "layout",
    "packing"
  ],
  "author": "Sisyphus",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/webcola": "^3.1.27",
    "d3-dag": "^1.2.2",
    "webcola": "^3.4.0"
  }
}
